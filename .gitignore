.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Frontend
node_modules/
frontend/dist/

# Local data of a development run: never the repository - but for the published seed data
/data/*
!/data/seed/
# named as well: the gold standard's judging sheets hold a document's wordings (app/quality/sheet.py)
/data/gold-local/

# Secrets of the local Compose setup (deploy/make-secrets.py)
/deploy/secrets/
# Key material, wherever it lands (as .dockerignore keeps it out of the images)
*.pem
*.key
